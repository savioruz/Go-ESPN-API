SERVER_ENV=development
SERVER_LOG_LEVEL=debug
SERVER_PORT=8080
SERVER_SHUTDOWN_CLEANUP_PERIOD_SECONDS=15
SERVER_SHUTDOWN_GRACE_PERIOD_SECONDS=15

APP_NAME="espn-local"
APP_PORT=8080
APP_CORS_ENABLE=true
APP_CORS_ALLOW_CREDENTIALS=true
APP_CORS_ALLOWED_HEADERS=Accept,Authorization,Content-Type,X-API-KEY,Set-Cookie,Access-Control-Allow-Credentials,Access-Control-Allow-Headers,Access-Control-Allow-Methods,Access-Control-Allow-Origin,Accept-Language
APP_CORS_ALLOWED_METHODS=GET,PUT,POST,PATCH,DELETE,OPTIONS
APP_CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://127.0.0.1:3000,http://localhost:3000
APP_CORS_MAX_AGE_SECONDS=300
APP_RATE_LIMITER_ENABLE=true
APP_RATE_LIMITER_MAX_REQUESTS=10
APP_RATE_LIMITER_WINDOW_SECONDS=60
APP_API_KEY="your-super-secret-api-key-change-this-in-production"

AUTH_SERVICE_URL="http://localhost:8081"

CACHE_REDIS_PRIMARY_HOST=localhost
CACHE_REDIS_PRIMARY_PORT=6379
CACHE_REDIS_PRIMARY_PASSWORD=strongpassword
CACHE_REDIS_PRIMARY_DB=0
CACHE_REDIS_PRIMARY_TLS=false
CACHE_TTL=120

DB_POSTGRES_READ_HOST="localhost"
DB_POSTGRES_READ_PORT=5432
DB_POSTGRES_READ_NAME="espn"
DB_POSTGRES_READ_USER="postgres"
DB_POSTGRES_READ_PASSWORD="password"
DB_POSTGRES_READ_TIMEZONE=UTC
DB_POSTGRES_READ_SSL_MODE=disable

DB_POSTGRES_WRITE_HOST="localhost"
DB_POSTGRES_WRITE_PORT=5432
DB_POSTGRES_WRITE_NAME="espn"
DB_POSTGRES_WRITE_USER="postgres"
DB_POSTGRES_WRITE_PASSWORD="password"
DB_POSTGRES_WRITE_TIMEZONE=UTC
DB_POSTGRES_WRITE_SSL_MODE=disable

DB_POSTGRES_MAX_RETRY=3
DB_POSTGRES_RETRY_WAIT_TIME=5
DB_POSTGRES_MIGRATION_TABLE="espn_migrations"
DB_POSTGRES_AUTO_MIGRATE=false
DB_POSTGRES_PREFIX=""

# OpenTelemetry traces. Leave empty to disable export. Point at jaeger:4317 when
# running the optional Jaeger service in docker-compose.
EXTERNAL_OTEL_ENDPOINT="43.128.73.61:4317"

# Jaeger UI/OTLP ports (only used by the optional docker-compose jaeger service).
JAEGER_UI_PORT=16686
JAEGER_OTLP_PORT=4317

SERVICES_ESPN_ENABLED=true
SERVICES_ESPN_RELAYS=
SERVICES_ESPN_TIMEOUT=30
SERVICES_ESPN_MAXRETRIES=3
SERVICES_ESPN_RETRY_BACKOFF_MIN=1
SERVICES_ESPN_RETRY_BACKOFF_MAX=10
# Worker ingest scope: comma-separated "sport:league" pairs the periodic jobs
# fan out over (ports base.py _DEFAULT_INGEST_LEAGUES). Override to trim/extend.
SERVICES_ESPN_INGEST_LEAGUES=soccer:fifa.world,soccer:eng.1,soccer:esp.1,soccer:ger.1,soccer:ita.1,soccer:fra.1,soccer:usa.1,soccer:eng.2,soccer:uefa.champions,soccer:uefa.europa,football:nfl,basketball:nba
# Max concurrent ingest units per job (the "too many clients" fix). Keep <= the
# Postgres pool max-open connections (currently 10).
SERVICES_ESPN_INGEST_CONCURRENCY=4
SERVICES_NHL_ENABLED=false
SERVICES_NHL_TIMEOUT=30
SERVICES_NHL_MAXRETRIES=3
# Bounds concurrent per-team roster ingests in the NHL rosters sync. Keep <= the
# Postgres pool max-open connections (currently 10).
SERVICES_NHL_INGEST_CONCURRENCY=4
